# DeepConsol environment configuration template
# Copy to .env and replace placeholders.

APP_ENV=production
APP_PUBLIC_HOST=your.public.ip.or.host
APP_PUBLIC_URL=https://your.public.ip.or.host

API_PORT=5001
TERMINAL_WS_PORT=5002
WEB_PORT=3002
API_HOST=127.0.0.1
TERMINAL_WS_HOST=127.0.0.1
WEB_HOST=127.0.0.1

DATABASE_URL=postgres://deepconsol:CHANGE_ME@127.0.0.1:5432/deepconsol
REDIS_URL=redis://127.0.0.1:6379/2

# 32+ random bytes hex
JWT_SECRET=CHANGE_ME
JWT_TTL_HOURS=12
SESSION_COOKIE_NAME=deepconsol_session

# 32 bytes base64 — `openssl rand -base64 32`
SSH_CRED_ENCRYPTION_KEY=CHANGE_ME

SEED_ADMIN_EMAIL=admin@deepconsol.local
SEED_ADMIN_PASSWORD=CHANGE_ME

GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-3-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_WEB_GROUNDING_ENABLED=true

STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/var/lib/deepconsol/docs

UPLOAD_MAX_BYTES=104857600
INGEST_CHUNK_TARGET_TOKENS=512
INGEST_CHUNK_OVERLAP_TOKENS=64

TERMINAL_IDLE_TIMEOUT_SEC=1800
TERMINAL_MAX_SESSIONS_PER_USER=8
TERMINAL_DEFAULT_SCROLLBACK=10000

CHAT_HISTORY_RETENTION_DAYS=90
CHAT_MAX_CONCURRENT_PER_USER=4

CORS_ALLOWED_ORIGINS=https://your.public.ip.or.host
LOG_LEVEL=info

# Optional outbound HTTP/HTTPS proxy for calls to Gemini / OpenAI / Anthropic.
# Node's built-in fetch() ignores these variables by default; the api + worker
# install undici's EnvHttpProxyAgent at startup when any of them is set.
# NO_PROXY supports comma-separated hosts, suffix matches (".internal"), and CIDR-less host:port pairs.
# HTTPS_PROXY=http://user:pass@proxy.corp.example:3128
# HTTP_PROXY=http://user:pass@proxy.corp.example:3128
# NO_PROXY=127.0.0.1,localhost,.internal
# If the proxy does TLS MITM, point Node at the corporate trust bundle:
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca-bundle.pem

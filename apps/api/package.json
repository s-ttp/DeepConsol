{
  "name": "@deepconsol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./config": "./dist/config.js",
    "./logger": "./dist/logger.js",
    "./proxy": "./dist/proxy.js",
    "./db/pool": "./dist/db/pool.js",
    "./db/migrate": "./dist/db/migrate.js",
    "./services/storage": "./dist/services/storage.js",
    "./services/gemini": "./dist/services/gemini.js",
    "./services/embedding": "./dist/services/embedding.js",
    "./services/sanitizer-config": "./dist/services/sanitizer-config.js",
    "./services/crypto": "./dist/services/crypto.js",
    "./services/audit": "./dist/services/audit.js",
    "./services/queue": "./dist/services/queue.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@deepconsol/shared": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.21.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "ssh2": "^1.16.0",
    "undici": "^7.25.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  }
}
